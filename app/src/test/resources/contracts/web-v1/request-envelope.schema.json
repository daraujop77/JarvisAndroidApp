{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis.web.request.v1",
  "title": "JARVIS Web V1 request envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "protocol_version",
    "contract_fingerprint",
    "request_id",
    "trace_id",
    "user_id",
    "device_id",
    "session_id",
    "conversation_id",
    "task_id",
    "run_id",
    "operation"
  ],
  "properties": {
    "schema": {"const": "jarvis.web.request.v1"},
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "contract_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"enum": ["submit", "resume", "cancel", "action"]},
    "action_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "side_effecting": {"type": "boolean"},
    "payload": {"type": "object"}
  }
}
