{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis.web.event.v1",
  "title": "JARVIS Web V1 event envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "protocol_version",
    "contract_fingerprint",
    "event_id",
    "sequence",
    "cursor",
    "type",
    "timestamp_utc",
    "user_id",
    "device_id",
    "session_id",
    "conversation_id",
    "request_id",
    "trace_id",
    "task_id",
    "run_id",
    "action_id",
    "payload",
    "optional"
  ],
  "properties": {
    "schema": {"const": "jarvis.web.event.v1"},
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "contract_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 1},
    "cursor": {"type": "string", "minLength": 1, "maxLength": 256},
    "type": {"type": "string", "minLength": 1, "maxLength": 128},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_id": {"type": ["string", "null"], "maxLength": 128},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": ["string", "null"], "maxLength": 128},
    "run_id": {"type": ["string", "null"], "maxLength": 128},
    "action_id": {"type": ["string", "null"], "maxLength": 128},
    "payload": {"type": "object"},
    "optional": {"type": "boolean"}
  }
}
