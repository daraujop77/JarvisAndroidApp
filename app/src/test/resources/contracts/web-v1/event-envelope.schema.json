{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/web-v1/event-envelope.schema.json",
  "title": "jarvis.web.v1 event envelope",
  "type": "object",
  "required": ["cursor", "event_id", "type", "protocol_version"],
  "properties": {
    "cursor": { "type": "string", "description": "opaque replay token; never parse as a number" },
    "event_id": { "type": "string" },
    "type": { "type": "string" },
    "protocol_version": { "type": "string" },
    "contract_fingerprint": { "type": "string" },
    "timestamp_utc": { "type": "string" },
    "optional": { "type": "boolean" },
    "payload": { "type": "object" },
    "user_id": { "type": "string" },
    "device_id": { "type": "string" },
    "session_id": { "type": "string" },
    "conversation_id": { "type": "string" },
    "request_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "action_id": { "type": "string" }
  },
  "additionalProperties": true
}
