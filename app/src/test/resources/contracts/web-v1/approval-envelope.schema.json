{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis.web.approval.v1",
  "title": "JARVIS Web V1 approval envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "protocol_version",
    "contract_fingerprint",
    "approval_id",
    "request_id",
    "trace_id",
    "action_id",
    "status",
    "expires_at"
  ],
  "properties": {
    "schema": {"const": "jarvis.web.approval.v1"},
    "protocol_version": {"type": "string"},
    "contract_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["required", "approved", "denied", "expired"]},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
